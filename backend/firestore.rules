rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /players/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['payload', 'nickname', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
      allow delete: if false;
      match /sessions/{session} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['payload', 'createdAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 10000;
        allow update, delete: if false;
      }
      match /wallet/{event} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['eventId', 'amount'])
          && request.resource.data.eventId is string
          && request.resource.data.eventId.size() < 160
          && request.resource.data.amount is int
          && request.resource.data.amount >= -300
          && request.resource.data.amount <= 100000000;
        allow update, delete: if false;
      }
    }
    match /leaderboards/{board}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Competition state and public score writes require Admin SDK; the client
    // can never promote its private cloud-save snapshot to a verified rank.
    match /competitionProfiles/{uid} { allow read, write: if false; }
    match /competitionSessions/{session} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
